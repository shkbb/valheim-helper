<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ValheimHelper</AssemblyName>
    <!-- The mod's version: the updater compares it with the latest GitHub release (tag v<Version>). -->
    <Version>1.1.2</Version>
    <RootNamespace>ValheimHelper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <ValheimDir>D:\SteamLibrary\steamapps\common\Valheim</ValheimDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <!-- Only Harmony (HarmonyX) is taken from the BepInEx pack. BepInEx itself is NOT used:
         its Valheim build forces Game.isModded = true, which blocks achievements. -->
    <HarmonyDir>$(MSBuildThisFileDirectory)..\deps\BepInExPack\BepInExPack_Valheim\BepInEx\core</HarmonyDir>
  </PropertyGroup>

  <!-- Editions (dotnet build -p:Edition=legal|helper|full): legal = map, guide, camera, statistics, settings, achievement
       list; helper = legal + base helper (chests, smelters, torches, crafting from chests, pickup, animals, world modifiers);
       full = everything, cheats included. The code of a higher edition is not compiled into a lower one at all. -->
  <PropertyGroup>
    <Edition Condition="'$(Edition)' == ''">full</Edition>
  </PropertyGroup>
  <!-- Distribution (dotnet build -p:Distribution=github|nexus): the Nexus Mods build has no updater (the site's rules) -->
  <PropertyGroup Condition="'$(Distribution)' == 'nexus'">
    <DefineConstants>$(DefineConstants);NEXUS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Edition)' == 'full'">
    <DefineConstants>$(DefineConstants);EDITION_FULL;EDITION_HELPER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Edition)' == 'helper'">
    <DefineConstants>$(DefineConstants);EDITION_HELPER</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Edition)' != 'full'">
    <Compile Remove="Patches\AchievementPatches.cs;Patches\BuildPatches.cs;Patches\MovementPatches.cs;Patches\PlayerPatches.cs;Patches\WorldPatches.cs" />
    <Compile Remove="Core\PlayerTools.cs;Core\WorldTools.cs;Core\Spawner.cs;Wiki\WikiStudio.cs" />
    <Compile Remove="Menu\CheatMenu.Players.cs;Menu\CheatMenu.World.cs;Menu\CheatMenu.Mobs.cs;Menu\CheatMenu.Gifts.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Edition)' == 'legal'">
    <Compile Remove="Patches\CraftPatches.cs;Patches\StoragePatches.cs;Storage\**\*.cs" />
    <Compile Remove="Menu\CheatMenu.Storage.cs;Menu\CheatMenu.Fires.cs;Menu\CheatMenu.Pickup.cs;Menu\CheatMenu.Modifiers.cs" />
    <Compile Remove="Core\WorldModifierEditor.cs;Menu\CheatMenu.Animals.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(HarmonyDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ManagedDir)\assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ParticleSystemModule"><HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ClothModule"><HintPath>$(ManagedDir)\UnityEngine.ClothModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(ManagedDir)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_postprocessing"><HintPath>$(ManagedDir)\assembly_postprocessing.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SoftReferenceableAssets"><HintPath>$(ManagedDir)\SoftReferenceableAssets.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Splatform"><HintPath>$(ManagedDir)\Splatform.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- shared with the boot DLL: which boot DLL Doorstop starts -->
  <ItemGroup>
    <Compile Include="..\Boot\BootFiles.cs" Link="Loader\BootFiles.cs" />
  </ItemGroup>

</Project>

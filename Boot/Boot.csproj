<Project Sdk="Microsoft.NET.Sdk">

  <!-- The first thing Doorstop loads (doorstop_config.ini → ValheimHelper\ValheimHelper.Boot.<n>.dll). It updates the mod
       while the mod's own DLL is not loaded yet, then loads that DLL and starts it. No game references.
       BootGeneration goes up whenever this DLL changes: a loaded DLL cannot be replaced, so a new one comes under a new name. -->
  <PropertyGroup>
    <BootGeneration>2</BootGeneration>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ValheimHelper.Boot.$(BootGeneration)</AssemblyName>
    <RootNamespace>ValheimHelper.Boot</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Distribution)' == 'nexus'">
    <DefineConstants>$(DefineConstants);NEXUS</DefineConstants>
  </PropertyGroup>

</Project>
